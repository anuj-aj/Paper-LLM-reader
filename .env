### General ###
PROJECT_NAME=paper-curator
API_PORT=8000

### PostgreSQL ###
POSTGRES_DB=curator
POSTGRES_USER=curator_user
POSTGRES_PASSWORD=curator_pwd
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

### OpenSearch ###
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_NAME=papers_v1

### Ollama ###
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=llama3:instruct
GEN_PROVIDER=ollama
GEN_MODEL=llama3:instruct

### Airflow ###
AIRFLOW_EXECUTOR=SequentialExecutor
AIRFLOW__CORE__FERNET_KEY=bG3IvhOnJdn5SoBh9Lc_10ZPWfClESCtastcTU1q_Bk
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__WEBSERVER__PORT=8080


### Arxiv Ingestion ###
ARXIV_SEARCH_QUERY=cat:cs.AI AND lastUpdatedDate:[20250910 TO 20250920]
ARXIV_RESULT_LIMIT=25
